# ============================================================
# Root-level environment reference — Private Rummy
# ============================================================
# This file documents every environment variable used across
# the backend and mobile sub-projects. Copy and customise in
# the respective sub-project directories.
#
# See backend/.env.example  for backend-specific variables.
# See mobile/.env           for mobile-specific variables.
# ============================================================

# ----- Backend (backend/.env) -----
PORT=3000
NODE_ENV=development
DATABASE_URL=
PG_SSL=true
ALLOWED_ORIGINS=*

# ----- Mobile (mobile/.env) -----
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
